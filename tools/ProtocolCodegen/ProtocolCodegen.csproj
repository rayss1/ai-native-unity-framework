<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Protobuf_CompileOutputs>false</Protobuf_CompileOutputs>
    <Protobuf_OutputPath>$(MSBuildThisFileDirectory)../../shared/generated/csharp</Protobuf_OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="All" />
    <Protobuf Include="$(MSBuildThisFileDirectory)../../shared/schemas/ainative/v1/gameplay.proto"
              Condition="'$(GenerateProtocol)' == 'true'"
              ProtoRoot="$(MSBuildThisFileDirectory)../../shared/schemas"
              GrpcServices="None"
              OutputDir="$(Protobuf_OutputPath)" />
  </ItemGroup>
</Project>
