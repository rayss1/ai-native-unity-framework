<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Protobuf_CompileOutputs>false</Protobuf_CompileOutputs>
    <Protobuf_OutputPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../shared/generated/csharp'))</Protobuf_OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="All" />
    <Protobuf Include="$(MSBuildThisFileDirectory)../../shared/schemas/ainative/v1/*.proto"
              Condition="'$(GenerateProtocol)' == 'true'"
              ProtoRoot="$(MSBuildThisFileDirectory)../../shared/schemas"
              GrpcServices="None"
              OutputDir="$([System.IO.Path]::GetFullPath('$(Protobuf_OutputPath)'))"
              CompileOutputs="false" />
  </ItemGroup>
</Project>
