<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AiNative.Server.Fantasy</AssemblyName>
    <RootNamespace>AiNative.Server.Fantasy</RootNamespace>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(MSBuildThisFileDirectory)../../../vendor/Fantasy/nupkg</RestoreAdditionalProjectSources>
    <!-- This adapter consumes Fantasy runtime APIs only; host-owned configuration is injected at composition time. -->
    <IsDirectFantasyNetReference>false</IsDirectFantasyNetReference>
    <FantasyConfigAutoDiscoveryEnabled>false</FantasyConfigAutoDiscoveryEnabled>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../shared/realtime/Realtime.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fantasy-Net" Version="2026.1.1001" />
  </ItemGroup>
</Project>
