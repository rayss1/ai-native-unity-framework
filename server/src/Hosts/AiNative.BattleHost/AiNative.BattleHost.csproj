<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AiNative.BattleHost</AssemblyName>
    <RootNamespace>AiNative.BattleHost</RootNamespace>
    <!-- The composition root owns Fantasy.config and enables its compile-time scene registry. -->
    <IsDirectFantasyNetReference>false</IsDirectFantasyNetReference>
    <FantasyConfigAutoDiscoveryEnabled>true</FantasyConfigAutoDiscoveryEnabled>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Modules/AiNative.Server.Fantasy/AiNative.Server.Fantasy.csproj" />
    <ProjectReference Include="../../Modules/AiNative.Server.Protocol/AiNative.Server.Protocol.csproj" />
    <ProjectReference Include="../../../../shared/gameplay/Gameplay.Shared.csproj" />
    <ProjectReference Include="../../../../shared/protocol/Protocol.Shared.csproj" />
    <ProjectReference Include="../../../../shared/realtime/Realtime.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fantasy.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fantasy-Net" Version="2026.1.1002" PrivateAssets="all" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
  </ItemGroup>
</Project>
